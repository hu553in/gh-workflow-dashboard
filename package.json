{
  "name": "gh-workflow-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "A client-side dashboard for monitoring GitHub Actions workflows across repositories.",
  "homepage": "https://gh-workflow-dashboard.vercel.app",
  "author": "Ruslan Khasanshin",
  "repository": "https://github.com/hu553in/gh-workflow-dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "ultracite check && stylelint --max-warnings 0 --ignore-path .gitignore '**/*.css'",
    "lint:fix": "ultracite fix && stylelint --max-warnings 0 --fix --ignore-path .gitignore '**/*.css'",
    "check:hooks": "lefthook validate",
    "check:workflows": "bunx github-actionlint",
    "check:renovate": "bunx --package renovate renovate-config-validator --strict --no-global renovate.json",
    "check:unused": "knip",
    "check:vulns": "bun audit --prod --audit-level=high",
    "check:all": "bun lint && bun check:hooks && bun check:workflows && bun check:renovate && bun check && bun run build && bun check:unused && bun check:vulns && bun test:coverage",
    "check:fix": "bun lint:fix && bun check:all",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "prepare": "if [ -n \"${CI:-}\" ] || [ \"${LEFTHOOK:-}\" = \"0\" ]; then exit 0; fi; lefthook install"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "knip": "^6.44.1",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.91.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "ultracite": "^8.1.1",
    "vite": "^8.3.3"
  },
  "packageManager": "bun@1.4.4"
}
